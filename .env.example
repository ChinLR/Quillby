LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=your-nebius-key-here
# Pick the model from the Nebius playground / models list. Test it tonight.
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Optional: model that reads uploaded images (default Qwen/Qwen3.8-27B)
# VISION_MODEL=Qwen/Qwen3.8-27B
# Optional switches:
# ENGINE=stub      scripted run, no LLM calls (fallback if the LLM is down)
# REPLAY_MODE=1    serve only cached LLM responses (for the demo)
# Voice call (ElevenLabs agent answering on its Twilio number):
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_AGENT_ID=agent_xxx
# Optional: the number to show, if you don't want it looked up from ElevenLabs
# COUNTERBOT_PHONE_NUMBER=+44...
# Optional: where the demo airline's policy page is fetched from
# POLICY_BASE_URL=http://127.0.0.1:8000
# Hosted (public) version:
# PUBLIC_MODE=1       rate limits per visitor and per day (RATE_INTAKE_PER_HOUR, RATE_RUNS_PER_HOUR, DAILY_INTAKE_CAP, DAILY_RUN_CAP)
# CALL_FEATURE=0      no phone call: the human agent settles in the chat
# ALLOW_ORIGINS=https://your-app.vercel.app   extra CORS origins (not needed when Vercel forwards /api)
