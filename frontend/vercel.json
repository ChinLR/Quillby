{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://quillby-backend.onrender.com/api/:path*" },
    { "source": "/northwind", "destination": "https://quillby-backend.onrender.com/northwind/" },
    { "source": "/northwind/:path*", "destination": "https://quillby-backend.onrender.com/northwind/:path*" }
  ]
}
